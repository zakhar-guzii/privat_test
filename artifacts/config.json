{
  "data_path": "train_df.csv",
  "data_sep": "\t",
  "id_col": "id",
  "target_col": "gb",
  "min_valid_values": 50,
  "low_variance_threshold": 0.01,
  "corr_threshold": 0.95,
  "mnar_min_missing_pct": 10.0,
  "mnar_pvalue_alpha": 0.05,
  "enable_missing_indicators": true,
  "enable_id_aggregations": true,
  "enable_temporal_deltas": true,
  "aggregation_funcs": [
    "mean",
    "std",
    "min",
    "max"
  ],
  "max_delta_features": 80,
  "n_splits": 5,
  "random_state": 42,
  "exclude_volatile_ids_from_validation": true,
  "precision_at_k_fraction": 0.1,
  "catboost_iterations": 150,
  "catboost_learning_rate": 0.05,
  "catboost_depth": 6,
  "lightgbm_n_estimators": 150,
  "lightgbm_learning_rate": 0.05,
  "lightgbm_num_leaves": 63,
  "output_dir": "artifacts",
  "save_models": true,
  "run_shap": false,
  "shap_sample_size": 2000,
  "cat_feature_prefix": "cat_",
  "num_feature_prefix": "num_"
}